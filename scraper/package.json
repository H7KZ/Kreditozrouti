{
	"name": "@kreditozrouti/scraper",
	"private": true,
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"dev": "dotenv -e ../.env -- tsx --watch src --exec ts-node -r tsconfig-paths/register src/index.ts --",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"lint": "eslint ./src --ext .ts,.js",
		"format": "prettier --write .",
		"preview": "node dist/scraper/src/index.js",
		"type-check": "tsc --noEmit && tsc -p src/Tests/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:regen": "dotenv -v FORCE_FIXTURES=1 -- vitest run",
		"generate-fixtures": "tsx --tsconfig tsconfig.json scripts/generate-fixtures.ts"
	},
	"dependencies": {
		"@kreditozrouti/core": "workspace:*",
		"@kreditozrouti/logger": "workspace:*",
		"@kreditozrouti/types": "workspace:*",
		"@opentelemetry/auto-instrumentations-node": "^0.79.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
		"@opentelemetry/sdk-node": "^0.221.0",
		"axios": "^1.19.0",
		"axios-retry": "^4.5.0",
		"bullmq": "^6.2.0",
		"bullmq-otel": "^2.0.1",
		"cheerio": "^1.2.0",
		"connect-redis": "^10.0.0",
		"dotenv": "^17.4.2",
		"ioredis": "^6.0.0",
		"moment": "^2.30.1",
		"turndown": "^7.2.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/node": "^26.2.0",
		"@types/turndown": "^5.0.6",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.2.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.12",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	}
}
