{
  "useTabs": true,
  "trailingComma": "none",
  "printWidth": 160,
  "tabWidth": 4,
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": ["<TYPES>", "<BUILT_IN_MODULES>", "<THIRD_PARTY_MODULES>", "^@mcp/(.*)$", "^[./]"]
}
