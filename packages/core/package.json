{
	"name": "@kreditozrouti/core",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"exports": {
		"./domain": {
			"import": "./dist/domain/index.js",
			"types": "./dist/domain/index.d.ts"
		},
		"./services/CourseService": {
			"import": "./dist/services/CourseService.js",
			"types": "./dist/services/CourseService.d.ts"
		},
		"./services/FacultyService": {
			"import": "./dist/services/FacultyService.js",
			"types": "./dist/services/FacultyService.d.ts"
		},
		"./services/StudyPlanService": {
			"import": "./dist/services/StudyPlanService.js",
			"types": "./dist/services/StudyPlanService.d.ts"
		},
		"./services/OptimizerService": {
			"import": "./dist/services/OptimizerService.js",
			"types": "./dist/services/OptimizerService.d.ts"
		},
		"./http": {
			"import": "./dist/http/index.js",
			"types": "./dist/http/index.d.ts"
		},
		"./queue": {
			"import": "./dist/queue/index.js",
			"types": "./dist/queue/index.d.ts"
		},
		"./utils": {
			"import": "./dist/utils/index.js",
			"types": "./dist/utils/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup && tsc --emitDeclarationOnly",
		"dev": "tsup --watch --no-clean",
		"type-check": "tsc --noEmit",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write src"
	},
	"dependencies": {
		"@kreditozrouti/types": "workspace:*",
		"kysely": "catalog:"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@ianvs/prettier-plugin-sort-imports": "catalog:",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-promise": "catalog:",
		"eslint-plugin-regexp": "catalog:",
		"eslint-plugin-unicorn": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
