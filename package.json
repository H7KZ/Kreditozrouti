{
	"name": "kreditozrouti",
	"private": true,
	"version": "1.0.0",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "turbo run build",
		"type-check": "turbo run type-check",
		"lint": "turbo run lint",
		"test": "turbo run build && pnpm --filter=@kreditozrouti/web run test && pnpm --filter=@kreditozrouti/scraper run test && pnpm --filter=@kreditozrouti/api run test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"boundaries": "depcruise packages/core apps/web apps/mcp --config .dependency-cruiser.cjs",
		"verify": "pnpm lint && pnpm boundaries && pnpm test && pnpm type-check && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@ianvs/prettier-plugin-sort-imports": "catalog:",
		"dependency-cruiser": "^18.4.0",
		"dotenv-cli": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-tailwindcss": "catalog:",
		"turbo": "^2.11.3",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
