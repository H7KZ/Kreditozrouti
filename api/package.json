{
	"name": "@kreditozrouti/api",
	"private": true,
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"dev": "dotenv -e ../.env -- tsx --watch src --exec ts-node -r tsconfig-paths/register src/index.ts",
		"build": "tsc && tsc-alias",
		"lint": "eslint ./src --ext .ts,.js",
		"format": "prettier --write .",
		"preview": "node --require ./dist/api/src/telemetry.js dist/api/src/index.js",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:regen": "dotenv -v FORCE_FIXTURES=1 -- vitest run"
	},
	"dependencies": {
		"@kreditozrouti/core": "workspace:*",
		"@kreditozrouti/logger": "workspace:*",
		"@kreditozrouti/types": "workspace:*",
		"@bull-board/api": "^9.4.0",
		"@bull-board/express": "^9.4.0",
		"@opentelemetry/auto-instrumentations-node": "^0.79.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
		"@opentelemetry/sdk-node": "^0.221.0",
		"axios": "^1.19.0",
		"body-parser": "^2.3.0",
		"bullmq": "^6.2.0",
		"bullmq-otel": "^2.0.1",
		"compression": "^1.8.1",
		"connect-redis": "^10.0.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"helmet": "^8.3.0",
		"i18n": "^0.15.3",
		"ioredis": "^6.0.0",
		"jose": "^6.2.10",
		"kysely": "^0.29.5",
		"multer": "^2.2.0",
		"mysql2": "^3.23.4",
		"nodemailer": "^9.0.5",
		"pino-http": "^11.0.0",
		"prom-client": "^15.1.3",
		"rate-limiter-flexible": "^11.2.0",
		"response-time": "^2.3.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/body-parser": "^1.19.6",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/i18n": "^0.13.12",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.2.0",
		"@types/nodemailer": "^8.0.1",
		"@types/response-time": "^2.3.9",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.2.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.12",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
