{
	"name": "@kreditozrouti/mcp",
	"version": "0.1.0",
	"description": "MCP server for Kreditožrouti — VŠE course scheduling data",
	"license": "MIT",
	"type": "module",
	"bin": {
		"kreditozrouti-mcp": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"scripts": {
		"dev": "dotenv -e ../.env -- tsx --watch src/index.ts",
		"build": "tsup",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write src",
		"type-check": "tsc --noEmit",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@kreditozrouti/core": "workspace:*",
		"@kreditozrouti/types": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"kysely": "^0.29.5",
		"mysql2": "^3.23.4",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.2.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.2.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.67.0"
	}
}
