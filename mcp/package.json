{
  "name": "@kreditozrouti/mcp",
  "version": "0.1.0",
  "description": "MCP server for Kreditožrouti — VŠE course scheduling data",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kreditozrouti-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx --watch src/index.ts",
    "build": "tsup",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@kreditozrouti/core": "*",
    "@modelcontextprotocol/sdk": "^1.12.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "kysely": "^0.29.2",
    "mysql2": "^3.22.5",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-unicorn": "^69.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.1",
    "tsup": "^8.2.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
