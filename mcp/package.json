{
  "name": "@kreditozrouti/mcp",
  "version": "0.1.0",
  "description": "MCP server for Kreditožrouti — VŠE course scheduling data",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kreditozrouti-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "build": "tsup",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "kysely": "^0.27.4",
    "mysql2": "^3.10.2",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-regexp": "^2.6.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  }
}
