# .env.example — copy to .env and fill in the values.
# The .env file must never be committed to version control.

# ─── 1. Core

# Project name — used as a prefix for Docker container names and Traefik labels.
PROJECT=kreditozrouti

# Runtime environment: local | development | production
ENV=local

# Primary domain (used by Traefik routers and cookie scoping in production).
DOMAIN=localhost


# ─── 2. API

# Port the Express API listens on.
API_PORT=40080

# Full public URI of the API (used for self-referencing links).
API_URI=http://localhost:40080

# Top-level domain for session cookie scoping (no protocol, no path).
API_DOMAIN=localhost

# Comma-separated list of allowed CORS origins.
API_ALLOWED_ORIGINS=http://localhost:45173,http://localhost:40080

# Secret used to sign session cookies — use a long random string in production.
API_SESSION_SECRET=local

# Bearer token required by /commands routes (scraper triggers).
API_COMMAND_TOKEN=local

# Directory where uploaded files are stored (relative to api/ working directory).
API_FILE_DESTINATION=uploads/

# Set to true to bypass Redis response caching (useful on localhost to see live data).
API_CACHE_DISABLED=false


# ─── 3. Client

# Full public URI of the Vue client (used by the API to construct callback URLs).
CLIENT_URI=http://localhost:45173

# Vite dev server port.
VITE_CLIENT_PORT=45173

# API base URL injected into the client bundle at build time.
VITE_API_URL=http://localhost:40080

# Grafana Faro collector endpoint for browser telemetry (errors, web vitals).
# Leave empty to disable Faro in local development.
VITE_FARO_COLLECTOR_URL=http://localhost:41247/collect

# App version tag sent to Faro for release tracking (e.g. v1.2.3 or a git SHA).
VITE_APP_VERSION=local

# Umami Analytics website ID (get from Umami dashboard → Settings → Websites).
# Leave empty to disable analytics in local development.
VITE_UMAMI_WEBSITE_ID=

# Umami script URL. Defaults to the production Umami instance.
# Leave empty to disable analytics in local development.
VITE_UMAMI_SRC=https://umami.kreditozrouti.cz/script.js



# ─── 4. MySQL

MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=kreditozrouti

# Full DSN used by Kysely — must match the credentials above.
MYSQL_URI=mysql://root:root@127.0.0.1:43306/kreditozrouti?sslmode=disable&schema=kreditozrouti


# ─── 5. Redis

REDIS_URI=redis://127.0.0.1:46379

# Leave empty if Redis has no password (default for local Docker setup).
REDIS_PASSWORD=


# ─── 6. Email

# Gmail address and App Password used by Nodemailer.
# Leave both empty to disable email sending entirely.
GOOGLE_USER=
GOOGLE_APP_PASSWORD=


# ─── 7. Monitoring

# Grafana admin credentials (used by the monitoring Docker Compose stack).
# Locally: http://localhost:43000 — default credentials below are fine for dev.
GRAFANA_ADMIN_USER=root
GRAFANA_ADMIN_PASSWORD=root

# Host 'docker' group GID, granted to Prometheus + Alloy so 'nobody' can read the
# mounted docker.sock for container discovery/log tailing. MUST equal the deploy
# host's value: run `getent group docker | cut -d: -f3` on that host and set it here.
# A wrong GID silently yields zero scrape targets and no logs (blank Grafana +
# permanent Container-Down alert). Compose falls back to 988 only if this is unset.
DOCKER_GID=988

# OTLP endpoint for API/scraper traces. Tracing is OPT-IN and OFF by default: the SDK
# only exports when this is set (see api/src/telemetry.ts). There is currently no OTLP
# receiver in the Alloy config (no otelcol.receiver.otlp) and no Tempo, so leaving this
# empty avoids a flood of failed-export errors. Set it once a receiver + Tempo exist.
OTEL_EXPORTER_OTLP_ENDPOINT=


# ─── 8. MCP server

MCP_JWT_SECRET=local

# Comma-separated https hosts (subdomains included) allowed as OAuth redirect_uri.
# Outside production, http://localhost and http://127.0.0.1 (any port) are also allowed.
# Leave unset to use the default: claude.ai,claude.com
MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com


# ─── 9. Scraper

# Global ceiling on outbound requests to InSIS, enforced in Redis so it holds across scraper
# replicas, worker concurrency and every job type (see
# docs/adr/0002-global-insis-rate-limit-not-a-concurrency-knob.md). Do NOT add a concurrency knob
# instead: the scraper's fan-out layers multiply, this ceiling does not.
# Every value below is optional - the scraper falls back to these same safe defaults if unset.

# Sustained requests per second across the whole deployment. 4 is a deliberate reduction against a
# university system we do not own: the previous unpaced peak was roughly 12 concurrent requests.
INSIS_RATE_LIMIT_RPS=4

# Token bucket capacity, i.e. how big a short burst may be before the sustained rate takes over.
INSIS_RATE_LIMIT_BURST=8

# How long a single request waits for a token before it gives up and fails the scrape.
INSIS_RATE_LIMIT_MAX_WAIT_MS=30000
