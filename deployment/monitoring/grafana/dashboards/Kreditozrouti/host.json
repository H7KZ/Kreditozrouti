      "title": "CPU",
      "description": "Share of CPU time per mode (excluding idle).",
      "targets": [
        {
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{project=\"kreditozrouti\", service=\"host\", mode!=\"idle\"}[$__rate_interval])) / scalar(count(node_cpu_seconds_total{project=\"kreditozrouti\", service=\"host\", mode=\"idle\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "legendFormat": "{{mode}}",
          "range": true,
          "instant": false
