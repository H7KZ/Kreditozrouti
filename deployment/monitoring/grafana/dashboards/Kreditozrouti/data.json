        {
          "expr": "max(mysql_global_status_threads_connected{project=\"kreditozrouti\", service=\"mysqld-exporter\", env=\"$env\"}) / max(mysql_global_variables_max_connections{project=\"kreditozrouti\", service=\"mysqld-exporter\", env=\"$env\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "legendFormat": "used",
          "instant": true,
          "range": false
