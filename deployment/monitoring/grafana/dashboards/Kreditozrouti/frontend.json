      "title": "LCP p75",
      "description": "75th percentile of browser-reported LCP over the selected range (Faro web vitals histogram). Good <= 2500, poor > 4000.",
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le) (increase(faro_web_vitals_lcp_milliseconds_bucket{project=\"kreditozrouti\", env=\"$env\"}[$__range])))",
