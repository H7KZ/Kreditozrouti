      "title": "Top pages",
      "description": "Page views and visitors per path.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "Umami"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT url_path AS page, count(*) AS views, count(DISTINCT session_id) AS visitors FROM website_event WHERE event_type = 1 AND $__timeFilter(created_at) AND website_id IN (SELECT website_id FROM website WHERE domain = 'kreditozrouti.cz' AND deleted_at IS NULL) GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ],
