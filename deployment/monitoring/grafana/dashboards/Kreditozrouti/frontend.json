        "builtIn": 0,
        "placement": "inControlsMenu",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "deploy",
            "kreditozrouti"
          ],
          "type": "tags"
        }
      }
    ]
  },
