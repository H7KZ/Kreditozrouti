          "rawSql": "SELECT event_name AS event, count(*) AS count, count(DISTINCT session_id) AS visitors FROM website_event WHERE event_type = 2 AND $__timeFilter(created_at) AND website_id IN (SELECT website_id FROM website WHERE domain = 'kreditozrouti.cz' AND deleted_at IS NULL) GROUP BY 1 ORDER BY 2 DESC"
        }
