        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "title": "Components up",
      "description": "Monitoring components currently scraped (of 5).",
      "targets": [
        {
          "expr": "count(up{project=\"kreditozrouti\", env=\"ops\", service=~\"prometheus|alertmanager|loki|alloy|grafana\"} == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "legendFormat": "up",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
