      "title": "Edge latency",
      "description": "p50/p95 from Traefik router histograms. Precision is limited by the Traefik bucket configuration.",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{project=\"kreditozrouti\", service=\"client\", env=\"$env\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{project=\"kreditozrouti\", service=\"client\", env=\"$env\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
