          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), count(DISTINCT session_id) AS visitors, count(*) FILTER (WHERE event_type = 1) AS views FROM website_event WHERE $__timeFilter(created_at) AND website_id IN (SELECT website_id FROM website WHERE domain = 'kreditozrouti.cz' AND deleted_at IS NULL) GROUP BY 1 ORDER BY 1"
