// Docker container log discovery → Loki
// Reads container stdout/stderr via Docker socket.
// Parses JSON lines (pino output) and extracts log level,
// service, and env as Loki stream labels.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "container_labels" {
  targets = discovery.docker.containers.targets

  // Drop monitoring infrastructure containers — their logs are noise, not application data.
  // Placed first so dropped containers never enter any downstream pipeline stage.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(grafana|prometheus|loki|alloy|umami|postgres).*"
    action        = "drop"
  }

  // Use container name as the "app" label (strip leading /)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "app"
  }

  // Expose container image for filtering
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }

  // Tag with Compose project for guaranteed env separation in log queries
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.container_labels.output
  forward_to = [loki.process.parse_json.receiver]
}

loki.process "parse_json" {
  // Attempt to parse JSON; non-JSON lines pass through as plain text.
  // Extract request_id and path in addition to standard label fields.
  stage.json {
    expressions = {
      level      = "level",
      service    = "service",
      env        = "env",
      context    = "context",
      request_id = "request_id",
      path       = "path",
      trace_id   = "trace_id",
      span_id    = "span_id",
    }
  }

  // Drop health-check and metrics-scrape log lines — high-frequency, zero signal.
  stage.drop {
    source              = "path"
    expression          = "^/(health|metrics)$"
    drop_counter_reason = "healthcheck_or_metrics_endpoint"
  }

  // Promote pino fields to Loki stream labels for indexed queries
  stage.labels {
    values = {
      level   = "",
      service = "",
      env     = "",
      context = "",
    }
  }

  // Store request_id as structured metadata (not a stream label) for per-request
  // trace correlation without blowing up label cardinality.
  stage.structured_metadata {
    values = {
      request_id = "",
      trace_id   = "",
      span_id    = "",
    }
  }


  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Grafana Faro receiver
// Accepts browser telemetry pushed by @grafana/faro-web-sdk.
// Forwards errors, logs, and web vitals to Loki.
// Browser SDK points to: https://domain/faro/collect (production)
//                        http://localhost:41247/collect (local dev)

faro.receiver "browser" {
  server {
    listen_address       = "0.0.0.0"
    listen_port          = 12347
    cors_allowed_origins = [sys.env("FARO_ALLOWED_ORIGIN")]
  }

  output {
    logs   = [loki.process.faro_labels.receiver]
  }
}

// Enrich Faro log lines before writing to Loki.
// Faro lines are logfmt (key=value). We add a static app label and
// promote the `kind` field (exception/event/log/measurement) to a
// stream label so dashboards can filter by {app="kreditozrouti", kind="exception"}.
loki.process "faro_labels" {
  stage.static_labels {
    values = {
      app = "kreditozrouti",
    }
  }

  stage.logfmt {
    mapping = {
      "kind" = "kind",
      "env"  = "app_environment",
    }
  }

  stage.labels {
    values = {
      kind = "",
      env  = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// ---------------------------------------------------------------------------
// Traefik access log pipeline
// ---------------------------------------------------------------------------
local.file_match "traefik_access" {
  path_targets = [{
    __path__ = "/var/log/traefik/access.log",
    job      = "traefik",
    service  = "traefik",
  }]
}

loki.source.file "traefik_access" {
  targets    = local.file_match.traefik_access.targets
  forward_to = [loki.write.default.receiver]
}

// ---------------------------------------------------------------------------
// MySQL backup health metrics pipeline (Alloy's first prometheus.* pipeline)
//
// WHY THIS IS PUSH WHEN EVERYTHING ELSE IS PULL:
// prometheus/prometheus.yml runs a single Docker-SD job that discovers containers
// labelled prometheus.io/scrape=true. The MySQL backup is a host-level systemd
// timer running scripts/backup-mysql.sh, not a container, so Docker-SD can never
// see it. Alloy already runs here and already mounts host paths, so it reads the
// *.prom file the backup script writes and pushes the result to Prometheus over
// the remote-write receiver. Full rationale, and why Pushgateway was rejected:
// docs/adr/0001-backup-health-via-alloy-textfile.md
//
// The directory below is the container-side path of the read-only bind mount
// /var/lib/kreditozrouti/textfile-collector declared in docker-compose.monitoring.yml.
// set_collectors replaces the node_exporter default set with textfile alone: we
// want the backup gauges, not CPU/filesystem/netdev metrics for the container's
// own namespace, which would be misleading host telemetry.
prometheus.exporter.unix "textfile" {
  set_collectors = ["textfile"]

  textfile {
    directory = "/var/lib/textfile-collector"
  }
}

// 60s is deliberately slow. The source is a daily batch job writing a timestamp
// gauge - the value changes at most once per day, so a faster interval would only
// buy storage cost. The staleness alert's threshold is 36h; 60s is far inside it.
// job_name is intentionally not set: the job label defaults to the component ID,
// and the alert matches on the kreditozrouti_backup_* metric names, not on job.
prometheus.scrape "backup_textfile" {
  targets         = prometheus.exporter.unix.textfile.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "60s"
}

// Requires --web.enable-remote-write-receiver on the Prometheus command args;
// without it Prometheus returns 404 on /api/v1/write and the gauges never land,
// which looks identical to a dead backup.
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
