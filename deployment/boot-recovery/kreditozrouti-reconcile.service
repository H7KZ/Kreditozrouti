[Unit]
Description=Kreditozrouti saved snapshot recovery
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/usr/sbin/runuser -u __USER__ -- env HOME=__HOME__ bash /usr/local/libexec/kreditozrouti-reconcile/reconcile.sh
TimeoutStartSec=90min

[Install]
WantedBy=multi-user.target
