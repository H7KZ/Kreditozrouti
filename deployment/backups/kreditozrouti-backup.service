[Unit]
Description=Capture Kreditozrouti backups to Kopia
Requires=docker.service
After=docker.service network-online.target
OnFailure=kreditozrouti-backup-alert.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/kreditozrouti-backup/environment
ExecStart=/usr/local/libexec/kreditozrouti-backup/capture.sh --confirm-production
TimeoutStartSec=3h
TimeoutStopSec=2min
KillMode=mixed
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kreditozrouti-backup
