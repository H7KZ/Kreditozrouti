[Unit]
Description=Send Kreditozrouti backup failure alert

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/kreditozrouti-backup/environment
ExecStart=/usr/local/libexec/kreditozrouti-backup/notify.sh failure
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kreditozrouti-backup-alert
