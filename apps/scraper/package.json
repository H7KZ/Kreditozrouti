{
	"name": "@kreditozrouti/scraper",
	"private": true,
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"dev": "dotenv run -f ../../.env -- tsx --watch src --exec ts-node -r tsconfig-paths/register src/index.ts --",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"lint": "eslint ./src --ext .ts,.js",
		"format": "prettier --write .",
		"preview": "node dist/apps/scraper/src/index.js",
		"type-check": "tsc --noEmit && tsc -p src/Tests/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:regen": "cross-env FORCE_FIXTURES=1 vitest run",
		"generate-fixtures": "tsx --tsconfig tsconfig.json scripts/generate-fixtures.ts"
	},
	"dependencies": {
		"@kreditozrouti/core": "workspace:*",
		"@kreditozrouti/logger": "workspace:*",
		"@kreditozrouti/types": "workspace:*",
		"@opentelemetry/auto-instrumentations-node": "catalog:",
		"@opentelemetry/exporter-trace-otlp-proto": "catalog:",
		"@opentelemetry/sdk-node": "catalog:",
		"axios": "catalog:",
		"axios-retry": "^4.5.0",
		"bullmq": "catalog:",
		"bullmq-otel": "catalog:",
		"cheerio": "^1.2.0",
		"connect-redis": "catalog:",
		"dotenv": "catalog:",
		"ioredis": "catalog:",
		"moment": "^2.31.0",
		"prom-client": "catalog:",
		"turndown": "^7.2.4"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@ianvs/prettier-plugin-sort-imports": "catalog:",
		"@types/node": "catalog:",
		"@types/turndown": "^5.0.6",
		"@typescript-eslint/parser": "catalog:",
		"cross-env": "^10.1.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-promise": "catalog:",
		"eslint-plugin-regexp": "catalog:",
		"eslint-plugin-unicorn": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"ts-node": "catalog:",
		"tsc-alias": "catalog:",
		"tsconfig-paths": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vitest": "catalog:"
	}
}
