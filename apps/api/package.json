{
	"name": "@kreditozrouti/api",
	"private": true,
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"dev": "dotenv -e ../../.env -- tsx --watch src --exec ts-node -r tsconfig-paths/register src/index.ts",
		"build": "tsc && tsc-alias",
		"lint": "eslint ./src --ext .ts,.js",
		"format": "prettier --write .",
		"preview": "node --require ./dist/apps/api/src/telemetry.js dist/apps/api/src/index.js",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:regen": "dotenv -v FORCE_FIXTURES=1 -- vitest run"
	},
	"dependencies": {
		"@kreditozrouti/core": "workspace:*",
		"@kreditozrouti/logger": "workspace:*",
		"@kreditozrouti/types": "workspace:*",
		"@opentelemetry/auto-instrumentations-node": "catalog:",
		"@opentelemetry/exporter-trace-otlp-proto": "catalog:",
		"@opentelemetry/sdk-node": "catalog:",
		"axios": "catalog:",
		"body-parser": "^2.3.0",
		"bullmq": "catalog:",
		"bullmq-otel": "catalog:",
		"compression": "^1.8.2",
		"connect-redis": "catalog:",
		"cors": "^2.8.6",
		"dotenv": "catalog:",
		"express": "catalog:",
		"express-session": "^1.19.0",
		"helmet": "^8.3.0",
		"i18n": "^0.15.4",
		"ioredis": "catalog:",
		"jose": "^6.2.12",
		"kysely": "catalog:",
		"multer": "^2.4.0",
		"mysql2": "catalog:",
		"nodemailer": "^10.0.10",
		"pino-http": "^11.0.0",
		"prom-client": "catalog:",
		"rate-limiter-flexible": "^11.2.1",
		"response-time": "^2.3.4",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@ianvs/prettier-plugin-sort-imports": "catalog:",
		"@types/body-parser": "^1.19.6",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "catalog:",
		"@types/express-session": "^1.19.0",
		"@types/i18n": "^0.13.12",
		"@types/multer": "^2.2.0",
		"@types/node": "catalog:",
		"@types/response-time": "^2.3.9",
		"@typescript-eslint/parser": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-promise": "catalog:",
		"eslint-plugin-regexp": "catalog:",
		"eslint-plugin-unicorn": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"ts-node": "catalog:",
		"tsc-alias": "catalog:",
		"tsconfig-paths": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vitest": "catalog:"
	}
}
